# CentOS 7 native deployment. Copy to .env.linux before installation.
DM_HOST=db-host
DM_PORT=5236
DM_USER=MCP_READ
DM_PASSWORD=replace-me
DM_ENCODING=UTF8

# Replace with the dedicated account and explicitly allowed business schemas.
DM_ALLOWED_OWNERS=MCP_READ,APP_SCHEMA
DM_DENIED_SCHEMAS=SYS,SYSSSO,SYSAUDITOR,SYSJOB,SYSDBA,SYSCONFIG
DM_REQUIRED_VERSION_PREFIX=V8

DM_POOL_MIN=1
DM_POOL_MAX=3
DM_POOL_WAIT_TIMEOUT_MS=5000
DM_QUERY_TIMEOUT_SECONDS=30
DM_MAX_ROWS=200
DM_MAX_SQL_LENGTH=10000
DM_MAX_CELL_CHARS=10000
DM_MAX_RESULT_BYTES=1048576

MCP_HOST=0.0.0.0
MCP_PORT=8082
MCP_PATH=/mcp
MCP_SSE_PATH=/sse
MCP_MESSAGE_PATH=/messages/
